 using std::stringstream;
 using std::for_each;
+
+// Supplemental DATA streams on non-root NTFS directories are file rows.
+// Keep dot aliases and root parenting on the existing directory path.
+static bool isNamedNtfsDirectoryData(const TSK_FS_FILE *fs_file,
+    const TSK_FS_ATTR *fs_attr)
+{
+    return fs_file != NULL && fs_file->fs_info != NULL
+        && fs_file->meta != NULL && fs_file->name != NULL
+        && fs_file->name->name != NULL && fs_file->name->name[0] != '\0'
+        && !TSK_FS_ISDOT(fs_file->name->name)
+        && fs_file->name->meta_addr != fs_file->fs_info->root_inum
+        && TSK_FS_TYPE_ISNTFS(fs_file->fs_info->ftype)
+        && fs_file->meta->type == TSK_FS_META_TYPE_DIR
+        && fs_attr != NULL && fs_attr->type == TSK_FS_ATTR_TYPE_NTFS_DATA
+        && fs_attr->name != NULL && fs_attr->name[0] != '\0';
+}
 
