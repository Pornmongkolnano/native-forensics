+/**
+ * Convert an exFAT local DOS timestamp using its per-entry UTC offset.
+ * Offset bit 7 indicates validity; the other seven bits are a signed count
+ * of 15-minute increments. Unknown offsets retain the FAT timezone fallback.
+ * Validate the civil date first so neither conversion normalizes corrupt data.
+ * Valid-offset conversion does not mutate process-global TZ or use DST.
+ */
+static time_t
+exfatfs_dos_2_unix_time(uint16_t date, uint16_t time, uint8_t timetens,
+    uint8_t utc_offset)
+{
+    static const int month_days[] = {0,31,59,90,120,151,181,212,243,273,304,334};
+    static const int month_lengths[] = {31,28,31,30,31,30,31,31,30,31,30,31};
+    int year, month, day, hour, minute, second, offset, leap;
+    int64_t days;
+
+    if (date == 0)
+        return 0;
+    year = ((date & FATFS_YEAR_MASK) >> FATFS_YEAR_SHIFT) + 1980;
+    month = (date & FATFS_MON_MASK) >> FATFS_MON_SHIFT;
+    day = (date & FATFS_DAY_MASK) >> FATFS_DAY_SHIFT;
+    hour = (time & FATFS_HOUR_MASK) >> FATFS_HOUR_SHIFT;
+    minute = (time & FATFS_MIN_MASK) >> FATFS_MIN_SHIFT;
+    second = ((time & FATFS_SEC_MASK) >> FATFS_SEC_SHIFT) * 2;
+    leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+    if (month < 1 || month > 12 || day < 1 ||
+        hour > 23 || minute > 59 || second > 59 || timetens > 199)
+        return 0;
+    if (day > month_lengths[month - 1] + (month == 2 && leap))
+        return 0;
+    if ((utc_offset & 0x80) == 0)
+        return fatfs_dos_2_unix_time(date, time, timetens);
+    days = (int64_t)(year - 1970) * 365 +
+        (year - 1) / 4 - 1969 / 4 -
+        (year - 1) / 100 + 1969 / 100 +
+        (year - 1) / 400 - 1969 / 400;
+    days += month_days[month - 1] + day - 1;
+    if (month > 2 && leap)
+        days++;
+    offset = utc_offset & 0x7f;
+    if (offset & 0x40)
+        offset -= 128;
+    return (time_t)(days * 86400 + hour * 3600 + minute * 60 + second +
+        timetens / 100 - offset * 900);
+}
 
